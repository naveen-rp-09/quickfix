 "css": "@page {\r\n    size: A4;\r\n    margin: 1cm;\r\n}\r\n\r\n.shop-name {\r\n    font-size: 28px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n.job-card {\r\n    text-align: center;\r\n\r\n}\r\n\r\n.print-summary {\r\n    text-align: center;\r\n    font-size: 13px;\r\n    margin: 10px 0 20px 0;\r\n    font-weight: bold;\r\n}\r\n\r\nh2 {\r\n    text-align: center;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n.final-amount {\r\n    font-size: 24px;\r\n    font-weight: bold;\r\n    text-align: right;\r\n}\r\n",
