 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"shop-name\">\r\n    {{ get_shop_name() }}\r\n</div>\r\n\r\n<h2>Job Card</h2>\r\n\r\n<p class=\"job-card\">\r\n    {{ doc.name }}\r\n</p>\r\n\r\n<div class=\"print-summary\">\r\n    {{ doc.print_summary }}\r\n</div>\r\n\r\n{% if doc.priority == \"Urgent\" %}\r\n<div>\r\n    URGENT\r\n</div>\r\n{% endif %}\r\n\r\n<div>\r\n    <h3>Customer Details</h3>\r\n\r\n    <table>\r\n        <tr>\r\n            <td><strong>Job Card</strong></td>\r\n            <td>{{ doc.name }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Customer Name</strong></td>\r\n            <td>{{ doc.customer_name }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Phone</strong></td>\r\n            <td>{{ doc.customer_phone }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Email</strong></td>\r\n            <td>{{ doc.customer_email }}</td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n\r\n<div>\r\n    <h3>Device Details</h3>\r\n\r\n    <table>\r\n\r\n        <tr>\r\n            <td><strong>Device Type</strong></td>\r\n            <td>{{ doc.device_type }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Brand</strong></td>\r\n            <td>{{ doc.device_brand }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Model</strong></td>\r\n            <td>{{ doc.device_model }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>IMEI / Serial</strong></td>\r\n            <td>{{ doc.imei_or_serial }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Status</strong></td>\r\n            <td>{{ doc.status }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><strong>Priority</strong></td>\r\n            <td>{{ doc.priority }}</td>\r\n        </tr>\r\n\r\n    </table>\r\n</div>\r\n\r\n    <h3>Parts Used</h3>\r\n    <table class=\"parts-table\">\r\n    <thead>\r\n        <tr>\r\n            <th>Part</th>\r\n            <th>Part Name</th>\r\n            <th>Quantity</th>\r\n            <th>Unit Price</th>\r\n            <th>Total</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for row in doc.parts_used %}\r\n        <tr>\r\n            <td>{{ row.part }}</td>\r\n            <td>{{ row.part_name }}</td>\r\n            <td>{{ row.quantity }}</td>\r\n            <td>\r\n                {{row.unit_price}}\r\n            </td>\r\n            <td>\r\n                {{row.total_price}}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<table>\r\n    <tr>\r\n        <td>\r\n            <strong>Parts Total</strong>\r\n        </td>\r\n\r\n        <td class=\"amount\">\r\n            {{doc.parts_total}}\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <td>\r\n            <strong>Labour Charge</strong>\r\n        </td>\r\n        <td class=\"amount\">\r\n            {{doc.labour_charge}}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n<div class=\"final-amount\">\r\n    <strong>\r\n        Final Amount:\r\n        {{doc.final_amount}}\r\n    </strong>\r\n</div>\r\n\r\n\r\n<div>\r\n    <table>\r\n        <tr>\r\n            <td><strong>Payment Status</strong></td>\r\n            <td>{{ doc.payment_status }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><strong>Status</strong></td>\r\n            <td>{{ doc.status }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>\r\n",
